# ─────────────────────────────────────────────────────────────────────────────
# RPI_Cluster — plantilla de configuración
#
# CÓMO USAR:
#   1. Copia este archivo como  .env      (copy .env.example .env)
#   2. Rellena lo que necesites. TODO es opcional: sin configurar nada el
#      programa funciona igual y escribe los resultados en ./output
#
# ⚠️ Este programa es LOCAL. No envía datos a ningún servicio externo: no hay
#    integraciones con Notion, Airtable ni correo automático, por las
#    restricciones de compliance de la empresa sobre conectores automatizados.
#    Los resultados se entregan abriendo el Excel/CSV generado y copiando al
#    archivo consolidado del equipo.
#
#    Por eso aquí NO hay tokens ni contraseñas que configurar.
# ─────────────────────────────────────────────────────────────────────────────


# ── Salida ───────────────────────────────────────────────────────────────────
# Carpeta donde se escriben los CSV. Si se deja vacío, usa ./output
RPI_OUTPUT_DIR=


# ── OpenFDA (opcional) ───────────────────────────────────────────────────────
# Sube el límite de peticiones de 240 a 1000 por minuto. Sin clave funciona
# igual, solo con el límite más bajo. Es gratuita y se obtiene en:
#   https://open.fda.gov/apis/authentication/
# No es una credencial de la empresa ni da acceso a nada privado.
FDA_API_KEY=


# ── Pruebas ──────────────────────────────────────────────────────────────────
# Poner en 1 salta las pruebas que salen a internet, dejando solo las rápidas.
# Recomendado para verificar que la instalación quedó bien:
#   RPI_SKIP_INTEGRATION=1 python -m unittest discover -s tests -t .
RPI_SKIP_INTEGRATION=
